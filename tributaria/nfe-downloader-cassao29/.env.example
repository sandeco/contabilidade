# ============================================================
# nfe-downloader — Configuração (copie este arquivo para .env e edite)
# ============================================================
#
# Para criar seu .env:
#   cp .env.example .env
#   $EDITOR .env
#
# IMPORTANTE: o arquivo .env contém credenciais. NUNCA commite.
# O .gitignore já está configurado para bloqueá-lo, mas confirme.

# ------------------------------------------------------------
# CNPJ da empresa (14 dígitos, somente números, sem . / -)
# ------------------------------------------------------------
SEFAZ_CNPJ=12345678000123

# ------------------------------------------------------------
# Certificado digital A1 da empresa (e-CNPJ)
# ------------------------------------------------------------
# Caminho absoluto para o arquivo .pfx ou .p12.
# O certificado precisa estar:
#   1. Válido (não expirado)
#   2. Vinculado a este CNPJ
#   3. Tipo A1 (arquivo) — A3 com token/cartão requer drivers extras.
#
# Recomendação: dê permissão restrita ao arquivo:
#   chmod 600 /caminho/para/certificado.pfx
SEFAZ_CERT_PATH=/caminho/absoluto/para/certificado.pfx
SEFAZ_CERT_PASSWORD=senha_do_certificado

# ------------------------------------------------------------
# Ambiente SEFAZ
# ------------------------------------------------------------
# Valores aceitos:
#   homologacao — para testes (recomendado no primeiro uso)
#   producao    — para baixar NF-e reais
#
# Se for sua primeira vez, deixe em "homologacao" e valide.
SEFAZ_AMBIENTE=homologacao

# ------------------------------------------------------------
# Código numérico da UF da empresa
# ------------------------------------------------------------
# Códigos IBGE das UFs:
#   11 RO   12 AC   13 AM   14 RR   15 PA   16 AP   17 TO
#   21 MA   22 PI   23 CE   24 RN   25 PB   26 PE   27 AL   28 SE   29 BA
#   31 MG   32 ES   33 RJ   35 SP
#   41 PR   42 SC   43 RS
#   50 MS   51 MT   52 GO   53 DF
SEFAZ_UF=35

# ------------------------------------------------------------
# Diretório onde os XMLs baixados serão salvos
# ------------------------------------------------------------
# Estrutura criada: $SEFAZ_STORAGE_DIR/<CNPJ>/{completos,resumos,eventos}/
# Pode ser caminho relativo (./nfe_storage) ou absoluto (/var/nfe).
#
# IMPORTANTE: os XMLs contêm dados fiscais sensíveis (LGPD).
# Não exponha esse diretório publicamente.
SEFAZ_STORAGE_DIR=./nfe_storage
